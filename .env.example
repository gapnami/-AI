# .env.example - 환경 변수 예시
# 실제 API 키는 이 파일을 복사하여 `.env`로 만들고 값을 채워 사용하세요.
# 주의: 값에 따옴표를 감싸면 코드에서 자동 제거되지만, 가능하면 따옴표 없이 입력하세요.

ENV=production          # test | production

# API 키 (예시)
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here
TMAP_APP_KEY=your_tmap_app_key_here
ODSAY_API_KEY=your_odsay_api_key_here

# 공통 설정
API_TIMEOUT=10
MAX_RETRIES=3
RATE_LIMIT=100
RETRY_DELAY=1.0

# API별 오버라이드(선택)
KAKAO_TIMEOUT=10
KAKAO_RATE_LIMIT=100
TMAP_TIMEOUT=10
TMAP_RATE_LIMIT=100

# 로깅
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=output/logs
